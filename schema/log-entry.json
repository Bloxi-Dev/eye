{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Log Entry",
  "description": "Schema for log entries in the eye database",
  "type": "object",
  "required": ["id", "timestamp", "type", "message"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the log entry",
      "pattern": "^[a-zA-Z0-9-_]+$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the log was created",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "description": "Type of log entry",
      "enum": ["info", "warning", "error", "debug", "audit"]
    },
    "message": {
      "type": "string",
      "description": "Log message content",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "description": "Service or component that generated the log"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the log entry",
      "properties": {
        "user": {
          "type": "string"
        },
        "ip": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "description": "Tags for categorizing logs",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
